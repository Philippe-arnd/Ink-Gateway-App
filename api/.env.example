# Copy to `.env` (git-ignored) and fill in before deploying.

# Required. Encrypts stored AI provider API keys at rest — never commit,
# never reuse across environments. Generate with:
#   openssl rand -base64 32
INK_GATEWAY_MASTER_KEY=

# Required. Shared invite code gating registration for the closed beta.
INK_GATEWAY_INVITE_CODE=

# Required for password-reset emails (forgot-password flow). Get a key at
# https://resend.com — needs a verified sending domain in production.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Ink Gateway <noreply@yourdomain.com>"

# Optional. Override the default model per provider (see src/llm/*.rs).
# ANTHROPIC_MODEL=claude-sonnet-5
# GEMINI_MODEL=gemini-2.5-flash
